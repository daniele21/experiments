# Copy values into your shell or local .env tooling. Do not commit secrets.

# Required for Korgis-local models.
KORGIS_BASE_URL=http://127.0.0.1:1235/v1

# Required only when selecting OpenAI API models.
OPENAI_API_KEY=

# Required only when selecting MiniCPM through ModelBest.
MINICPM_API_KEY=
# Optional override; models.yaml contains a non-secret provider default.
# MINICPM_BASE_URL=https://api.modelbest.cn/v1

# Required only when selecting TypeSafe / Jev models.
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0

# Optional transport/lifecycle overrides.
# BENCHMARK_MAX_RETRIES=0
# BENCHMARK_TIMEOUT_SECONDS=60
# KORGIS_CONTROL_TIMEOUT_SECONDS=360

# Optional MCB-12 resource telemetry controls for Korgis-local runs.
# Enabled by default.
# MCB_RESOURCE_TELEMETRY=1
# MCB_RESOURCE_SAMPLE_INTERVAL_MS=250
