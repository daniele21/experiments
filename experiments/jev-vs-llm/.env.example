# Jev / TypeSafe
TYPESAFE_API_KEY=
# Pin the version for reproducible benchmarks; update deliberately when evaluating a new release.
JEV_MODEL=jev-1.13.0

# LLM baseline. Keep the model explicit so benchmark runs are reproducible.
OPENAI_API_KEY=
# Single-model commands can use OPENAI_MODEL.
OPENAI_MODEL=gpt-5.6-terra
# Comparison commands default to this matrix.
OPENAI_MODELS=gpt-5.6-luna,gpt-5.6-terra,gpt-5.6-sol
# Decision/classification benchmark: avoid paying for unnecessary reasoning tokens.
OPENAI_REASONING_EFFORT=none

# MiniCPM official API (ModelBest). This is a remote API provider, not a Korgis/GGUF model.
MINICPM_API_KEY=
MINICPM_BASE_URL=https://api.modelbest.cn/v1
MINICPM_MODEL=MiniCPM-V-4.6-1B
MINICPM_MAX_OUTPUT_TOKENS=2048

# Cost calculations use the dated pricing_snapshot.json committed with the benchmark.
# Update that snapshot deliberately when provider list prices change.

# Record where latency was measured (e.g. milan-local, aws-us-west-2).
BENCHMARK_LOCATION=

# Normalize transport behavior across providers for latency/error-rate comparisons.
BENCHMARK_MAX_RETRIES=0
BENCHMARK_TIMEOUT_SECONDS=60

# Korgis / Local LLM Server
KORGIS_BASE_URL=http://127.0.0.1:1235/v1
KORGIS_API_KEY=local
KORGIS_MODELS=nemotron-nano-4b,qwen3-vl-4b
# Korgis model load/startup may legitimately take longer than one inference request.
KORGIS_CONTROL_TIMEOUT_SECONDS=360
KORGIS_MAX_OUTPUT_TOKENS=2048
